{
  "name": "melato-agent-swarm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/preview-supabase-probe.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:env": "node scripts/validate-env.mjs",
    "supply-chain:check": "node scripts/check-supply-chain.mjs",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "founder:session": "node scripts/create-founder-session.mjs",
    "db:migrate": "node scripts/db-migrate.mjs apply",
    "db:migration:bundle": "node scripts/db-migrate.mjs bundle",
    "db:verify": "node scripts/db-migrate.mjs apply verify"
  },
  "dependencies": {
    "dotenv": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
}
