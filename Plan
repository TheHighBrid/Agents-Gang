13. Create the API route
Create:
app/api/chat/route.ts
Example skeleton:
import Anthropic from "@anthropic-ai/sdk";
import { orchestratorPrompt } from "../../../agents/orchestrator";
import { productPageAgentPrompt } from "../../../agents/productPageAgent";
import { creativeDirectorAgentPrompt } from "../../../agents/creativeDirectorAgent";
import { shopifyOpsAgentPrompt } from "../../../agents/shopifyOpsAgent";
import { conciergeAgentPrompt } from "../../../agents/conciergeAgent";
import { financeAgentPrompt } from "../../../agents/financeAgent";

const anthropic = new Anthropic({
  apiKey: process.env.ANTHROPIC_API_KEY!,
});

const agentPrompts: Record<string, string> = {
  product_page_agent: productPageAgentPrompt,
  creative_director_agent: creativeDirectorAgentPrompt,
  shopify_ops_agent: shopifyOpsAgentPrompt,
  concierge_agent: conciergeAgentPrompt,
  finance_agent: financeAgentPrompt,
};

export async function POST(req: Request) {
  const { message } = await req.json();

  // 1. Ask orchestrator where to route
  const routeResponse = await anthropic.messages.create({
    model: "claude-opus-4-8",
    max_tokens: 1000,
    system: orchestratorPrompt,
    messages: [
      {
        role: "user",
        content: message,
      },
    ],
  });

  const routeText =
    routeResponse.content[0].type === "text"
      ? routeResponse.content[0].text
      : "{}";

  const route = JSON.parse(routeText);
  const selectedPrompt = agentPrompts[route.agent];

  if (!selectedPrompt) {
    return Response.json({
      error: "No valid agent selected",
      route,
    });
  }

  // 2. Run specialist agent
  const agentResponse = await anthropic.messages.create({
    model: "claude-opus-4-8",
    max_tokens: 4000,
    system: selectedPrompt,
    messages: [
      {
        role: "user",
        content: message,
      },
    ],
  });

  const output =
    agentResponse.content[0].type === "text"
      ? agentResponse.content[0].text
      : "";

  return Response.json({
    route,
    output,
  });
}
