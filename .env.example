# Supported runtime provider: anthropic
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: override the default model without changing application code.
ANTHROPIC_MODEL=claude-opus-4-8

# Required for governed execution persistence. Server-side only; never expose or commit real values.
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Required to verify signed founder sessions for approval and observability APIs. Server-side only.
FOUNDER_AUTH_SECRET=your_founder_auth_secret
# Optional comma-separated session IDs revoked before their expiry. Server-side only.
FOUNDER_REVOKED_SESSION_IDS=session-to-revoke

# Optional read-only web search tool configuration. Server-side only.
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# Required for metadata-only Gmail inbox reads. Server-side only; never expose or commit real values.
GMAIL_ACCESS_TOKEN=your_gmail_oauth_access_token

# Required only when governed Shopify product reads are invoked. Server-side only.
SHOPIFY_STORE_DOMAIN=melato.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_token
