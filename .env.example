# Supported runtime provider: anthropic
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: override the default model without changing application code.
ANTHROPIC_MODEL=claude-opus-4-8

# Required for governed execution persistence. Server-side only; never expose or commit real values.
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Required only when governed Shopify product reads are invoked. Server-side only.
SHOPIFY_STORE_DOMAIN=melato.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_token
