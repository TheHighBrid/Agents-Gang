# Managed deployment target. Staging and production fail closed on invalid configuration.
AGENTS_GANG_ENVIRONMENT=development

# AI is optional when explicitly disabled.
AI_ENABLED=true
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key
# Optional: override the default model without changing application code.
ANTHROPIC_MODEL=claude-opus-4-8

# Required for governed execution persistence in staging/production. Server-side only.
SUPABASE_URL=https://project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Required to verify signed founder sessions in staging/production. Server-side only.
FOUNDER_AUTH_SECRET=your_founder_auth_secret
# Optional comma-separated session IDs revoked before their expiry. Server-side only.
FOUNDER_REVOKED_SESSION_IDS=session-to-revoke

# Optional read-only web search. Disabled integrations do not block unrelated operation.
WEB_SEARCH_ENABLED=true
BRAVE_SEARCH_API_KEY=your_brave_search_api_key

# Optional Gmail read/draft integration. Sending is a separate explicit high-risk capability switch.
GMAIL_ENABLED=true
GMAIL_ACCESS_TOKEN=your_gmail_oauth_access_token
GMAIL_SEND_ENABLED=false
# Optional bounded Gmail provider timeout in milliseconds (1,000-30,000; defaults to 10,000).
GMAIL_REQUEST_TIMEOUT_MS=10000

# Optional high-priority inbox alert webhook. Treat the webhook URL as a server-side secret.
INBOX_ALERTS_ENABLED=false
INBOX_ALERT_WEBHOOK_URL=https://alerts.example.com/inbox

# Governed Shopify adapter. Development/staging must use test mode; production must use production mode.
SHOPIFY_ENABLED=true
SHOPIFY_STORE_MODE=test
SHOPIFY_STORE_DOMAIN=agents-gang-test.myshopify.com
SHOPIFY_TEST_STORE_DOMAIN=agents-gang-test.myshopify.com
SHOPIFY_REQUEST_TIMEOUT_MS=10000
SHOPIFY_ADMIN_ACCESS_TOKEN=your_shopify_admin_token

# Migration-only connection secret for `npm run db:migrate`. Not required by the app runtime.
DATABASE_URL=postgresql://db_user:db_password@db.example.com:5432/agents_gang?sslmode=require
